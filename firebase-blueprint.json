{
  "entities": {
    "User": {
      "title": "User",
      "description": "App user with role-based permissions",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "employee"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction (income/expense)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "categoryId": { "type": "string" },
        "accountId": { "type": "string" },
        "date": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "scope": { "type": "string" },
        "notes": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "amount", "type", "categoryId", "accountId", "date"]
    },
    "Account": {
      "title": "Account",
      "description": "Financial account (bank, cash, etc.)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "balance": { "type": "number" },
        "currency": { "type": "string" }
      },
      "required": ["id", "name", "type", "balance", "currency"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Sales or purchase invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "date": { "type": "string" },
        "dueDate": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "taxAmount": { "type": "number" },
        "status": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "invoiceNumber", "customerName", "date", "totalAmount", "status"]
    },
    "Debt": {
      "title": "Debt",
      "description": "Personal or business debts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "personName": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "type": { "type": "string" },
        "startDate": { "type": "string" },
        "dueDate": { "type": "string" },
        "status": { "type": "string" },
        "paidAmount": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["id", "personName", "amount", "type", "startDate", "status"]
    },
    "Contract": {
      "title": "Contract",
      "description": "Legal or business contracts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "partnerName": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "value": { "type": "number" },
        "status": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "title", "partnerName", "startDate", "status"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global application settings",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "companyVatNumber": { "type": "string" },
        "companyPhone": { "type": "string" },
        "enableSecurityLock": { "type": "boolean" },
        "securityPin": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and roles"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial transactions"
    },
    "/accounts/{accountId}": {
      "schema": "Account",
      "description": "Bank and cash accounts"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Invoices"
    },
    "/debts/{debtId}": {
      "schema": "Debt",
      "description": "Debts"
    },
    "/contracts/{contractId}": {
      "schema": "Contract",
      "description": "Contracts"
    },
    "/settings/global": {
      "schema": "Settings",
      "description": "Global settings"
    }
  }
}
