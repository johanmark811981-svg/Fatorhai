rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // Global Helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isEmployee() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['employee', 'admin'];
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------------------
    // Entities Validation
    // -------------------------------------------------------------------------
    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0 &&
             data.email is string && data.email.size() > 0 &&
             data.role in ['admin', 'employee'];
    }

    function isValidTransaction(data) {
      return data.id is string &&
             data.title is string && data.title.size() > 0 &&
             data.amount is number &&
             data.type in ['income', 'expense'] &&
             data.categoryId is string &&
             data.accountId is string &&
             data.date is string;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      // Users can read their own doc, admins can get any user doc and list the entire collection
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name'])) ||
        isAdmin()
      );
    }

    // Financial Data Collections
    match /transactions/{transactionId} {
      allow read: if isEmployee();
      allow create: if isEmployee();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /accounts/{accountId} {
      allow read: if isEmployee();
      allow write: if isEmployee(); // Allow employees to update balances on transactions
    }

    match /invoices/{invoiceId} {
      allow read: if isEmployee();
      allow create: if isEmployee();
      allow update: if isEmployee(); // Allow employees to edit invoices they created?
      allow delete: if isAdmin();
    }

    match /debts/{debtId} {
      allow read: if isEmployee();
      allow create: if isEmployee();
      allow update: if isEmployee();
      allow delete: if isAdmin();
    }

    match /contracts/{contractId} {
      allow read: if isEmployee();
      allow create: if isEmployee();
      allow update: if isEmployee();
      allow delete: if isAdmin();
    }

    match /settings/global {
      allow read: if true;
      allow write: if isAdmin() || 
                    !exists(/databases/$(database)/documents/settings/global) ||
                    (resource != null && (!('adminPin' in resource.data) || resource.data.adminPin == ''));
    }
  }
}
